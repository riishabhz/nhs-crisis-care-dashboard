model Model
	culture: en-IN
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-IN
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup 'RAW Data'

	annotation PBI_QueryGroupOrder = 0

queryGroup Transform

	annotation PBI_QueryGroupOrder = 1

queryGroup Load

	annotation PBI_QueryGroupOrder = 2

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Crisis Dataset","Stg_Crisis","Entity_Crisis","Ref_FirstF2F","Ref_AllContacts","Dim_ReferralSource","Dim_Ethnicity","Dim_Team","Dim_Locality","Fact_Contact","Fact_Referral","Fact_Trajectory"]

annotation PBI_ProTooling = ["DevMode"]

ref table Fact_Referral
ref table Fact_Contact
ref table Dim_Locality
ref table Dim_Team
ref table Dim_ReferralSource
ref table Dim_Ethnicity
ref table Dim_Date
ref table Fact_Trajectory

ref cultureInfo en-IN

