table Fact_Contact
	lineageTag: 67c0fcc0-dd67-4ec0-b1c2-4ac763c10bca

	measure 'Total Contacts' = COUNTROWS ( Fact_Contact )
		formatString: #,0
		displayFolder: 05 Operational
		lineageTag: b443cc42-5a67-487f-8efc-8634284ef406

	measure 'F2F Contacts' = CALCULATE ( COUNTROWS ( Fact_Contact ), Fact_Contact[Contact Medium Clean] = "Face to face" )
		formatString: #,0
		displayFolder: 05 Operational
		lineageTag: 1dfcb0d9-7f24-4eb4-a58c-000f74910733

	measure 'F2F Contact %' = DIVIDE ( [F2F Contacts], [Total Contacts] )
		formatString: 0.0%
		displayFolder: 05 Operational
		lineageTag: 9f06e1af-41e1-4ffe-8023-4d204564c4e9

	measure 'Avg Contacts per Referral' = DIVIDE ( [Total Contacts],[Total Referrals] )
		displayFolder: 05 Operational
		lineageTag: b80144af-ff1e-4a88-933e-b9a289308cc0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Contact Outcome Recorded %' = DIVIDE ( CALCULATE ( COUNTROWS ( Fact_Contact ), NOT Fact_Contact[Contact Outcome] IN { "Not recorded", "Not Known" } ), [Total Contacts] )
		formatString: 0.0%
		displayFolder: 07 Data Quality
		lineageTag: a771213a-a9dc-4762-9f6e-73215d98e46a

