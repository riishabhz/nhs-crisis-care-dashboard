	column 'Contact Response Band Sort' = SWITCH ( TRUE (), Fact_Referral[HoursToFirstContact] < 0, 0, ISBLANK ( Fact_Referral[HoursToFirstContact] ), 5, Fact_Referral[HoursToFirstContact] <= 4, 1, Fact_Referral[HoursToFirstContact] <= 24, 2, Fact_Referral[HoursToFirstContact] <= 72, 3, 4 )
