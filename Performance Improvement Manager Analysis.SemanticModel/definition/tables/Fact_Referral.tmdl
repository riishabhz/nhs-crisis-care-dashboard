	column 'AgeBand Sort' =
			
			SWITCH (
			    TRUE (),
			    ISBLANK ( Fact_Referral[Age] ), 9,
			    Fact_Referral[Age] < 18, 1,
			    Fact_Referral[Age] <= 25, 2,
			    Fact_Referral[Age] <= 35, 3,
			    Fact_Referral[Age] <= 50, 4,
			    Fact_Referral[Age] <= 65, 5,
			    6
			)
		isHidden
